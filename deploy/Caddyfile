# Certificat HTTPS Let's Encrypt obtenu et renouvelé automatiquement pour {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip
	# Liste des joueurs connectés : seulement depuis le serveur (./who.sh).
	respond /admin/* 404
	reverse_proxy 127.0.0.1:3000
}

# Signalisation du serveur vidéo LiveKit (même certificat, port 7443).
{$DOMAIN}:7443 {
	reverse_proxy 127.0.0.1:7880
}
